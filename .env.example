# Render PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/database

# Use a long random value in Render
JWT_SECRET=replace-with-a-long-random-secret

# Seed users used on first database initialization
ADMIN_PASSWORD=replace-with-admin-password
DONOR_PASSWORD=replace-with-donor-password
ORGANIZATION_PASSWORD=replace-with-organization-password

NODE_ENV=development
